<?xml version="1.0" encoding="utf-8"?>
<!--
  Referenced by the FileProvider in AndroidManifest.xml. Exposes only the
  cacheDir/shared folder that MainActivity.shareFile() writes exported
  PDFs/JPGs/ZIPs into, so the Android share sheet can read them via a
  content:// Uri.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="shared_files" path="shared/" />
</paths>
