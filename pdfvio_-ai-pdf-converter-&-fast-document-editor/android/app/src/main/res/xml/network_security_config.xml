<?xml version="1.0" encoding="utf-8"?>
<!--
  Referenced by AndroidManifest.xml (android:networkSecurityConfig).
  Only allows plain HTTPS connections — the web app URL (strings.xml ->
  web_app_url) is already https://, and this blocks any accidental
  cleartext (http://) traffic for security.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
